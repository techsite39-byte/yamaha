# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace_with_meta_webhook_verify_token
WHATSAPP_APP_SECRET=replace_with_meta_app_secret
WHATSAPP_ACCESS_TOKEN=replace_with_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_meta_business_account_id
WHATSAPP_API_VERSION=v21.0

# SMTP Email Configuration (Password Reset & Security Alerts)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Vathilai Motors Security <your_email@example.com>"
